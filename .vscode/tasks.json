{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Project",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "windows-debug"
            ],
            "windows": {
                "args": [
                    "--preset",
                    "windows-debug"
                ]
            },
            "osx": {
                "args": [
                    "--preset",
                    "macos-debug"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Project",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "windows-debug"
            ],
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "windows-debug"
                ]
            },
            "osx": {
                "args": [
                    "--build",
                    "--preset",
                    "macos-debug"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure Project",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}
